# cppcheck suppressions file
# Only universally-supported suppression IDs here.
# Version-specific IDs go in Makefile.cbm as --suppress flags.

# Vendored code
*:internal/cbm/vendored/*
*:vendored/*

# Test framework patterns
unusedFunction:tests/*

# Intentional patterns
constVariablePointer
constParameterPointer
constVariable

# Cppcheck false positives (value-domain analysis gaps)
uninitvar:src/mcp/mcp.c  # ids[] initialized in loop before use (line 9586-9590)
knownConditionTrueFalse:src/mcp/mcp.c  # shown=min(count,6); count>shown is not always false
